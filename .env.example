# Configure apenas no ambiente de hospedagem (ex.: Vercel), nunca no frontend ou no Git.
BLACKCAT_API_KEY=
BLACKCAT_API_URL=https://api.blackcatoficial.com/api/sales/create-sale
# Só configure os campos do cliente se forem exigidos pelo contrato vigente da Blackcat.
# Use dados reais e compatíveis com o significado de "customer" na API; nunca use dados de exemplo.
BLACKCAT_CLIENT_NAME=
BLACKCAT_CLIENT_EMAIL=
BLACKCAT_CLIENT_DOCUMENT=
BLACKCAT_CLIENT_DOCUMENT_TYPE=cpf
